  "lyrics": [
    {
      "id": "line-1",
      "startMs": 14960,
      "text": "내가 사준 옷을 걸치고"
    },
    {
      "id": "line-2",
      "startMs": 18500,
      "text": "내가 사준 향술 뿌리고"
    },
    {
      "id": "line-3",
      "startMs": 22260,
      "text": "지금쯤 넌 그녈 만나"
    },
    {
      "id": "line-4",
      "startMs": 25940,
      "text": "또 웃고 있겠지"
    },
    {
      "id": "line-5",
      "startMs": 29680,
      "text": "그렇게 좋았던 거니"
    },
    {
      "id": "line-6",
      "startMs": 33230,
      "text": "날 버리고 떠날 만큼"
    },
    {
      "id": "line-7",
      "startMs": 36940,
      "text": "얼마나 더 어떻게"
    },
    {
      "id": "line-8",
      "startMs": 40570,
      "text": "더 잘 해야 한 거니"
    },
    {
      "id": "line-9",
      "startMs": 43930,
      "text": "너를 아무리 지울래도"
    },
    {
      "id": "line-10",
      "startMs": 47410,
      "text": "함께한 날이 얼마인데"
    },
    {
      "id": "line-11",
      "startMs": 51320,
      "text": "지난 시간이 억울해서"
    },
    {
      "id": "line-12",
      "startMs": 54850,
      "text": "자꾸 눈물이 흐르지만"
    },
    {
      "id": "line-13",
      "startMs": 60190,
      "text": "보여줄게 완전히 달라진 나"
    },
    {
      "id": "line-14",
      "startMs": 63850,
      "text": "보여줄게 훨씬 더 예뻐진 나"
    },
    {
      "id": "line-15",
      "startMs": 67550,
      "text": "바보처럼 사랑 때문에 떠난"
    },
    {
      "id": "line-16",
      "startMs": 70230,
      "text": "너 때문에 울지 않을래"
    },
    {
      "id": "line-17",
      "startMs": 75870,
      "text": "더 멋진 남잘 만나 꼭 보여줄게"
    },
    {
      "id": "line-18",
      "startMs": 79730,
      "text": "너보다 행복한 나"
    },
    {
      "id": "line-19",
      "startMs": 82310,
      "text": "너 없이도 슬프지 않아 무너지지않아"
    },
    {
      "id": "line-20",
      "startMs": 86910,
      "text": "boy you gotta be aware"
    },
    {
      "id": "line-21",
      "startMs": 92700,
      "text": "산뜻하게 머릴 바꾸고"
    },
    {
      "id": "line-22",
      "startMs": 96140,
      "text": "정성 들여 화장도 하고"
    },
    {
      "id": "line-23",
      "startMs": 99830,
      "text": "하이힐에 짧은 치마 모두 날 돌아봐"
    },
    {
      "id": "line-24",
      "startMs": 107150,
      "text": "우연히 라도 널 만나면"
    },
    {
      "id": "line-25",
      "startMs": 110370,
      "text": "눈이 부시게 웃어주며"
    },
    {
      "id": "line-26",
      "startMs": 114100,
      "text": "놀란 니 모습 뒤로 한 채"
    },
    {
      "id": "line-27",
      "startMs": 117850,
      "text": "또각 또각 걸어가려 해"
    },
    {
      "id": "line-28",
      "startMs": 122900,
      "text": "보여줄게 완전히 달라진 나"
